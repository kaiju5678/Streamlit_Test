# Copy to .env (read by config.py). Real environment variables win over this file.

# ---- Segmentation server (inference/server.py). Leave empty to disable "Run segmentation".
INFERENCE_URL=http://127.0.0.1:8000/segment
INFERENCE_API_KEY=
# Fallback label scheme if the server does not send X-Label-Scheme: generic | totalseg
INFERENCE_SCHEME=generic

# ---- Language model for draft reports: any OpenAI-compatible server (vLLM, Ollama, llama.cpp, TGI).
# Leave LLM_URL empty to use rule-based drafts only.
LLM_URL=
LLM_MODEL=google/medgemma-1.5-4b-it
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=120000
# Thinking models (MedGemma 1.5) use part of this budget for reasoning before the answer.
LLM_MAX_TOKENS=3000

# ---- Folders (relative paths are relative to this folder)
# Signed reports and the signing key are stored here. Back it up.
DATA_DIR=./data
# Optional Ed25519 private key (PKCS#8 PEM, \n-escaped). If unset, one is generated in DATA_DIR/signing-key.pem.
SIGNING_KEY_PEM=
